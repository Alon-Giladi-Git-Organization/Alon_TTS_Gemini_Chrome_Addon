{
  "manifest_version": 3,
  "name": "Advanced AI Page Reader",
  "version": "2.3",
  "description": "הקראת דפי אינטרנט ומסמכי Google Docs באמצעות AI",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "identity"
  ],
  "host_permissions": [
    "https://texttospeech.googleapis.com/*",
    "https://docs.googleapis.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "oauth2": {
    "client_id": "9826139997-4ngegll5irdmnfgh0buj5d13r2bsecaq.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/documents.readonly"
    ]
  },
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}